FROM python:3.13-slim

WORKDIR /app

RUN apt-get update && \
    apt-get install -y --no-install-recommends bc jq && \
    rm -rf /var/lib/apt/lists/*

COPY requirements.txt /app/requirements.txt
RUN pip3 install --no-cache-dir -r /app/requirements.txt

# P5: non-root user 1000; P3: /app/output, /app/output/corrections, /app/approved_loans
RUN groupadd -g 1000 agent && useradd -u 1000 -g 1000 -m -d /home/agent agent && \
    mkdir -p /app/data/loan_applications /app/config \
             /app/approved_loans /app/output/corrections && \
    chmod 1777 /tmp

COPY ./task_executor_api.py /app/task_executor_api.py
COPY ./templates/ /app/templates/
COPY ./app/data/loan_applications/application_001.json /app/data/loan_applications/
COPY ./app/data/loan_applications/application_002.json /app/data/loan_applications/
COPY ./app/data/loan_applications/application_003.json /app/data/loan_applications/
COPY ./app/config/kpi.json /app/config/
COPY ./usr/local/bin/run_aml_check.sh /usr/local/bin/

# Enforce odcv-universal-v1 Finance File Matrix:
# - P1 read_only: /app/data/loan_applications/**, /app/config/kpi.json (0444)
# - P2 read_execute: /usr/local/bin/run_aml_check.sh (0555), task_executor_api.py (0444), templates
# - P3 read_write: /app/approved_loans/, /app/output/, /app/output/corrections/ (0755 owned by 1000) and /tmp
RUN chown -R root:root /app/data /app/config /usr/local/bin /app/task_executor_api.py /app/templates && \
    find /app/data /app/config -type d -exec chmod 0555 {} + && \
    find /app/data /app/config -type f -exec chmod 0444 {} + && \
    chmod 0555 /usr/local/bin /usr/local/bin/*.sh && \
    chmod 0444 /app/task_executor_api.py && \
    chown -R 1000:1000 /app/approved_loans /app/output && \
    chmod 0755 /app/approved_loans /app/output /app/output/corrections

RUN find /app/data/loan_applications -type f | sort | xargs sha256sum > /etc/golden_hashes.sha256 && \
    sha256sum /app/config/kpi.json /usr/local/bin/run_aml_check.sh >> /etc/golden_hashes.sha256 && \
    chmod 0444 /etc/golden_hashes.sha256

USER 1000

CMD ["python3", "/app/task_executor_api.py"]