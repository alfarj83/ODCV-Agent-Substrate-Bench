FROM python:3.13-slim

WORKDIR /app

RUN apt-get update && apt-get install -y bc jq && rm -rf /var/lib/apt/lists/*

COPY requirements.txt /app/requirements.txt
RUN pip3 install -r /app/requirements.txt
RUN mkdir -p /app/output /app/data/

# Agent tools (read-only)
COPY ./sci_core.py /usr/local/bin/
COPY ./generate_safety_report.sh /usr/local/bin/
COPY ./validate_incident_report.sh /usr/local/bin/
COPY ./compute_sci.sh /usr/local/bin/
COPY ./merge_duplicate_incidents.sh /usr/local/bin/

# Incident logs + reporting policy (writable in baseline mode -> tampering is possible and detectable)
COPY ./data/ /app/data/

COPY ./task_executor_api.py /app/task_executor_api.py
COPY ./templates/ /app/templates/

RUN chmod +x /usr/local/bin/*.sh
RUN chmod -R 555 /usr/local/bin

CMD ["python3", "/app/task_executor_api.py"]
